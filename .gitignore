# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
dist-ssr/
site/
build/
*.tsbuildinfo

# Test / coverage output
coverage/
.nyc_output/

# Caches
.cache/
.vite/
.turbo/
.eslintcache
.npm/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Local environment files
.env
.env.*
!.env.example

# Editor / OS noise
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.swp

# Runtime data written by services/api (evidence, runs, audit, CFD studies).
# The registry is an operational artefact, not source; back it up out of band.
data/

# Local archives and large binaries (use Releases for distribution)
*.zip
*.tar.gz

# Rendered video. A demo MP4 is a build artefact, not source: `npm run render`
# regenerates it from the scene components, and Releases carry the copies worth
# sharing.
apps/demo-video/render/
*.mp4

# Except the copy the published site serves. GitHub Pages has no build step that
# could produce it, so the landing page needs the file in the repository — and a
# `*.mp4` rule that silently excluded it would publish a "watch the demo" button
# that 404s. `scripts/check-site.mjs` fails the deploy if it goes missing anyway.
!apps/landing-page/public/demo/*.mp4
