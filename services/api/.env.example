# AeroScribe API — environment
#
# Copy to `.env` (git-ignored), or pass these to your process manager or
# container. Every value has a safe default; the file documents them all.
#
#   cp services/api/.env.example services/api/.env
#   npm run start:api
#
# Nothing here is read by either browser app: the dashboard and the landing page
# never see a secret. See docs/BACKEND.md § 9 for the full description of each
# variable and § 10 for what happens when each dependency is missing.

# ── Network ──────────────────────────────────────────────────────────────────
# Bind address. 127.0.0.1 is the safe default; use 0.0.0.0 inside a container
# (the Dockerfile sets it) and keep TLS in front of the process.
HOST=127.0.0.1
PORT=8787

# Comma-separated allowlist of browser origins permitted to call the API.
AEROSCRIBE_CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# ── Authentication ───────────────────────────────────────────────────────────
# How this process decides who is calling: "none", "token" or "oidc". Unset means
# "token" when an API key is configured and "none" otherwise, which is what every
# existing deployment already gets.
#
#   none   no credential at all. /health reports authRequired:false — honest on a
#          laptop, dangerous on anything reachable.
#   token  one shared bearer key. Authenticates a caller, never a person: the
#          audit trail records the `actor` the caller types.
#   oidc   a verified identity per request, with roles and run ownership (§ below).
AEROSCRIBE_AUTH=

# `token` mode only. Refused together with oidc (a key would be a second, weaker
# way in) and refused with auth=none (a key nobody checks is worse than no key).
# Generate one with: openssl rand -hex 32
AEROSCRIBE_API_KEY=

# ── OpenID Connect (`AEROSCRIBE_AUTH=oidc`) ──────────────────────────────────
# The issuer must be https (loopback is exempt for local testing) and must match
# the `issuer` its discovery document advertises, or the process refuses to start
# and, if it drifts at runtime, every request answers 503 auth_unavailable.
# OIDC_ISSUER=https://login.example.org/realms/aeroscribe
# The audience this API accepts: the API's own client id at the IdP.
# OIDC_AUDIENCE=aeroscribe-api
# The public client id the dashboard uses for the PKCE flow (defaults to the
# audience). It is public by nature and is served by /api/v1/auth/config.
# OIDC_CLIENT_ID=aeroscribe-dashboard
# OIDC_SCOPES=openid profile email
# OIDC_CLOCK_SKEW_SECONDS=60
# Comma-separated subjects that arrive as admin. There is no bootstrap account
# and no password to set: this list is how a deployment gets its first admin.
# A login can promote from this list and never demote.
# AEROSCRIBE_ADMIN_SUBS=

# ── Storage ──────────────────────────────────────────────────────────────────
# Registry, runs, audit trail and CFD study directories. Point this at a
# persistent volume: the evidence registry *is* the audit trail.
AEROSCRIBE_DATA_DIR=./data
# Storage adapter: "filesystem" or "postgres". Anything else stops the process at
# boot instead of writing somewhere you did not choose.
AEROSCRIBE_STORE=filesystem
# Only read when AEROSCRIBE_STORE=postgres, and then required. Run
# `npm run db:migrate` once before starting the API against a fresh database.
# AEROSCRIBE_DATABASE_URL=postgres://user:password@127.0.0.1:5432/aeroscribe

# ── Coordination ─────────────────────────────────────────────────────────────
# Where the rate limit (RULE-013) and the stage lock live. "process" keeps both
# in memory: correct for one instance, and two instances behind a load balancer
# then get 60 requests each and may run the same stage twice. "redis" shares
# them. /health reports which one you have.
AEROSCRIBE_COORDINATION=process
# Only read when AEROSCRIBE_COORDINATION=redis, and then required.
# AEROSCRIBE_REDIS_URL=redis://user:password@127.0.0.1:6379/0

# ── Literature providers ─────────────────────────────────────────────────────
# Contact address sent to the Crossref polite pool. Set it: anonymous traffic is
# rate-limited first.
AEROSCRIBE_CONTACT_EMAIL=

# Server-side only. Semantic Scholar works without it at a lower rate limit;
# with a key the request spacer drops from 1.1 s to 200 ms per call.
SEMANTIC_SCHOLAR_API_KEY=

# true = never touch the network, serve the bundled fixture corpus instead.
# Fixture papers carry NO DOI by design, so an offline run can never cite
# anything (RULE-002). Useful for tests, demos and air-gapped machines.
AEROSCRIBE_OFFLINE=false

# ── CFD ──────────────────────────────────────────────────────────────────────
# Absolute path to an executable SU2_CFD. Unset (or missing) means a request for
# `solver: "su2"` is answered with 503 capability_unavailable — never with a
# silent downgrade. Without it, stage 4 runs the labelled synthetic benchmark,
# which blocks submission.
SU2_CFD_BINARY=

# ── LaTeX ────────────────────────────────────────────────────────────────────
# Absolute path to a TeX engine (`pdflatex`). Unset means stage 8 still writes
# `manuscript.tex`, records typeset="source-only" and blocks submission with
# "the manuscript PDF was not typeset (LATEX_BINARY is not set)". There is no
# silent fallback to a browser-side renderer.
LATEX_BINARY=

# Wall-clock limit for one engine pass, in milliseconds. A document needs two
# passes (the second resolves the bibliography), so the worst case is twice this.
LATEX_TIMEOUT_MS=120000

# ── Observability ────────────────────────────────────────────────────────────
# One JSON object per line on stdout: debug | info | warn | error | silent.
# `silent` is for tests; an operator who needs quiet should filter with jq.
LOG_LEVEL=info

# Reported by /health so a deployed instance can be identified. The image sets
# these at build time; leaving them empty reports `dev` / `unknown`.
AEROSCRIBE_VERSION=
GIT_SHA=

# ── HTTP client behaviour ────────────────────────────────────────────────────
# Per-attempt and per-provider deadline in milliseconds.
AEROSCRIBE_UPSTREAM_TIMEOUT_MS=15000

# First backoff step; the schedule is 2 s, 4 s, 8 s, 16 s (RULE-042), capped 30 s.
AEROSCRIBE_RETRY_BASE_MS=2000

# ── Reference re-checks (RULE-002) ───────────────────────────────────────────
# How old a stored DOI verification may be before a re-check reports it `stale`
# and stage 8 asks for a re-check. Reported, never silently renewed.
AEROSCRIBE_DOI_MAX_AGE_DAYS=30
