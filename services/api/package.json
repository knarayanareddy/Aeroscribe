{
  "name": "@aeroscribe/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AeroScribe agent runtime: pipeline orchestration, evidence registry, literature clients and CFD adapters",
  "main": "./src/index.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "smoke:literature": "tsx scripts/literature-smoke.ts",
    "smoke:cfd": "tsx scripts/cfd-smoke.ts",
    "recheck": "tsx scripts/recheck.ts",
    "smoke:latex": "tsx scripts/latex-smoke.ts",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:verify": "tsx scripts/db-verify.ts",
    "db:import": "tsx scripts/db-import.ts"
  },
  "dependencies": {
    "@aeroscribe/contract": "0.1.0",
    "@aeroscribe/pipeline": "0.1.0",
    "@hono/node-server": "^2.1.5",
    "hono": "^4.10.7",
    "pg": "^8.23.1",
    "tsx": "^4.20.6"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "embedded-postgres": "^18.6.0-beta.19"
  }
}
