# AeroScribe — the compose stack
#
#   cp .env.example .env
#   openssl rand -hex 32                 # paste into AEROSCRIBE_API_KEY
#   docker compose up -d --build
#
# This file configures the *stack*: which images, which hostname, which port,
# which database password. The API's own settings (rate limits, upstream
# timeouts, DOI age) live in `services/api/.env.example` and are passed through
# by `compose.yaml`; only the ones a deployment must change appear here.
#
# `.env` is git-ignored. It contains a secret: the bearer token every `/api/v1`
# call needs. Do not commit it, do not paste it into a workflow log.

# ── Identity ────────────────────────────────────────────────────────────────
# Reported by GET /health as `version` and `commit`, so a smoke test can prove
# which build answered it. The release workflow sets both to the tag and the
# commit it built; `dev` / `unknown` is what a working-tree build honestly is.
AEROSCRIBE_VERSION=dev
GIT_SHA=unknown

# Images. Pin a release tag to deploy a release; `local` builds from this tree.
# AEROscribe images are published to ghcr.io/knarayanareddy/aeroscribe-api and
# .../aeroscribe-dashboard by .github/workflows/release-api.yml.
#   AEROSCRIBE_API_IMAGE=ghcr.io/knarayanareddy/aeroscribe-api:v0.3.0
#   AEROSCRIBE_WEB_IMAGE=ghcr.io/knarayanareddy/aeroscribe-dashboard:v0.3.0
AEROSCRIBE_API_IMAGE=aeroscribe-api:local
AEROSCRIBE_WEB_IMAGE=aeroscribe-dashboard:local

# ── Edge ────────────────────────────────────────────────────────────────────
# The hostname in the certificate. A real name with an A record gets a Let's
# Encrypt certificate; `localhost` gets Caddy's internal CA, which every browser
# warns about once. Do not put an IP here: no public CA issues certificates for
# one, so the request would fail and the dashboard would be unreachable over
# TLS.
AEROSCRIBE_DOMAIN=localhost
# Host ports. 443 needs privileges; 8080/8443 work for a non-root demo.
AEROSCRIBE_HTTP_PORT=80
AEROSCRIBE_HTTPS_PORT=443

# ── Secrets ─────────────────────────────────────────────────────────────────
# The bearer token. Caddy injects it on the way to the API, and the API requires
# it, so the value must be non-empty or `docker compose up` refuses to start
# (that is the `:?` in compose.yaml — a stack with no token is a stack anyone on
# the network can drive). Generate it, do not invent it.
AEROSCRIBE_API_KEY=

# The Postgres password. Same rule: no default, because a default would ship.
# If it contains `@`, `:` or `/`, percent-encode it — it is interpolated into a
# URL (postgres://aeroscribe:PASSWORD@postgres:5432/aeroscribe).
AEROSCRIBE_DB_PASSWORD=

# ── Runtime ─────────────────────────────────────────────────────────────────
# false = talk to Crossref, arXiv and Semantic Scholar. true = never touch the
# network and serve the bundled fixture corpus, whose papers carry no DOI, so an
# offline run can never cite anything. Default true here: a stack that reaches
# the internet the moment it boots is a stack that fails behind a firewall.
AEROSCRIBE_OFFLINE=true

# Sent to the Crossref polite pool. Set it: anonymous traffic is rate-limited
# first and may be blocked outright.
AEROSCRIBE_CONTACT_EMAIL=

# Server-side only, never sent to a browser.
SEMANTIC_SCHOLAR_API_KEY=

LOG_LEVEL=info

# ── Capability switches ─────────────────────────────────────────────────────
# SU2 is not in the image. Leave this empty and every run is labelled synthetic
# and blocked at stage 8 — the honest state, and what `smoke-deploy.sh
# --expect-solver synthetic` asserts. Point it at an absolute path inside the
# container only if you built an image that contains the solver.
SU2_CFD_BINARY=

# TeX is not in the image unless AEROSCRIBE_INSTALL_LATEX=true (the build then
# carries ~250 MB of texlive). With it on, set LATEX_BINARY=/usr/bin/pdflatex;
# with it off, stage 8 still writes the `.tex`, records `typeset:
# "source-only"` and blocks submission.
AEROSCRIBE_INSTALL_LATEX=false
LATEX_BINARY=
LATEX_TIMEOUT_MS=120000
